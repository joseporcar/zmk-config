#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/*&left_encoder {
    status = "okay";
    steps = <60>;
};

&right_encoder {
    status = "okay";
    steps = <60>;
};

&msc {
    time-to-max-speed-ms = <0>;
    acceleration-exponent = <0>;
};

*/

&tog { toggle-mode = "flip"; locking;};

/ {
    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
        triggers-per-rotation = <30>;
    };

    behaviors {
        msc_v: msc_vertical {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        msc_h: msc_horizontal {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        colemak_dh {
            display-name = "Colemak-DH";
            bindings = <
&kp TAB         &kp Q  &kp W  &kp F     &kp P     &kp B                                                  &kp J  &kp L  &kp U      &kp Y    &kp SEMI  &kp SQT
&kp BSPC        &kp A  &kp R  &kp S     &kp T     &kp G                                                  &kp M  &kp N  &kp E      &kp I    &kp O     &kp RET
&kp UNDERSCORE  &kp Z  &kp X  &kp C     &kp D     &kp V      &kp ESC    &mkp MB4  &mkp MB5   &kp DEL     &kp K  &kp H  &kp COMMA  &kp DOT  &kp FSLH  &kp GRAVE
                              &kp LALT  &kp LGUI  &kp SPACE  &kp LCTRL  &kp PIPE  &kp PSCRN  &kp LSHIFT  &mo 1  &mo 2  &kp RALT
            >;

            sensor-bindings = <&msc_v>, <&msc_h>;
        };

        Navigation {
            display-name = "Navigation layer";
            bindings = <
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &bt BT_CLR                                                &trans          &kp HOME        &kp END       &trans           &kp PG_UP  &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &bt BT_SEL 0                                              &kp LEFT        &kp DOWN        &kp UP        &kp RIGHT        &kp PG_DN  &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &trans     &mkp LCLK  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &mkp RCLK  &kp RS(LSHIFT)
                         &trans   &trans   &trans        &trans        &trans  &mkp MCLK  &trans     &trans          &tog 1          &kp LCTRL
            >;

            sensor-bindings = <&msc_v>, <&msc_h>;
        };

        nums_and_symbols {
            display-name = "numbers and symbols";
            bindings = <
&kp EQUAL      &kp LS(PLUS)  &kp N7  &kp N8  &kp N9  &kp LS(STAR)                                  &kp LS(AT)    &kp LS(LBRC)  &kp LS(RBRC)  &kp HASH    &kp CARET  &trans
&trans         &kp MINUS     &kp N4  &kp N5  &kp N6  &kp FSLH                                      &kp LS(AMPS)  &kp LS(LPAR)  &kp LS(RPAR)  &kp LBKT    &kp RBKT   &trans
&kp LS(PRCNT)  &kp N0        &kp N1  &kp N2  &kp N3  &kp DOT       &trans  &trans  &trans  &trans  &kp LS(DLLR)  &kp LS(EXCL)  &kp LS(LT)    &kp LS(GT)  &kp BSLH   &trans
                                     &trans  &trans  &trans        &trans  &trans  &trans  &trans  &tog 2        &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp K_VOLUME_UP K_VOLUME_DOWN>, <&msc_h>;
        };
    };
};
