#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        msc_enc: msc_enc {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "MSC_ENC";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    macros {
        two_keys: two_keys {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp RSHIFT &kp LSHIFT>;

            label = "TWO_KEYS";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        colemak_dh {
            display-name = "Colemak-DH";
            bindings = <
&kp TAB         &kp Q  &kp W  &kp F     &kp P  &kp B                                                 &kp J      &kp L  &kp U      &kp Y    &kp SEMI  &kp SQT
&kp BSPC        &kp A  &kp R  &kp S     &kp T  &kp G                                                 &kp M      &kp N  &kp E      &kp I    &kp O     &kp RET
&kp UNDERSCORE  &kp Z  &kp X  &kp C     &kp D  &kp V      &kp ESC   &mkp MB1  &mkp MB2   &kp DEL     &kp K      &kp H  &kp COMMA  &kp DOT  &kp FSLH  &kp GRAVE
                              &kp LALT  &mo 1  &kp SPACE  &kp LGUI  &kp PIPE  &kp PSCRN  &kp LSHIFT  &kp LCTRL  &mo 2  &kp RALT
            >;

            sensor-bindings =
                <&msc_enc SCRL_UP SCRL_DOWN>,
                <&msc_enc SCRL_LEFT SCRL_RIGHT>;
        };

        Navigation {
            display-name = "Navigation layer";

            // ---------------------------------------------------------------------------------------------------------------------------------
            // |       |      |BT_CLR|BTSEL0|BTSEL1|BTSEL2|                                         |      |      |      |      |      |      |
            // |       |      |      |BTSEL3|BTSEL4|      |                                         |      |      |      |      |      |      |
            // |       |      |      |      |      |      |      |      |      |      |      |      |      |      |      |      |      |      |
            //                       |      |      |      |      |      |      |      |      |      |      |      |      |

            bindings = <
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans                                  &trans          &trans    &trans  &trans     &kp PG_UP  &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &trans                                  &kp LEFT        &kp DOWN  &kp UP  &kp RIGHT  &kp PG_DN  &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans  &trans  &trans  &trans  &bt BT_CLR_ALL  &trans    &trans  &trans     &trans     &trans
                         &trans   &trans   &trans  &trans  &trans  &trans  &trans  &trans          &tog 1    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        nums_and_symbols {
            bindings = <
&kp EQUAL      &kp LS(PLUS)  &kp N7  &kp N8  &kp N9  &kp LS(STAR)                                  &kp LS(AT)    &kp LS(LBRC)  &kp LS(RBRC)  &kp HASH    &kp CARET  &trans
&trans         &kp MINUS     &kp N4  &kp N5  &kp N6  &kp FSLH                                      &kp LS(AMPS)  &kp LS(LPAR)  &kp LS(RPAR)  &kp LBKT    &kp RBKT   &trans
&kp LS(PRCNT)  &kp N0        &kp N1  &kp N2  &kp N3  &kp DOT       &trans  &trans  &trans  &trans  &kp LS(DLLR)  &kp LS(EXCL)  &kp LS(LT)    &kp LS(GT)  &kp BSLH   &trans
                                     &trans  &tog 2  &trans        &trans  &trans  &trans  &trans  &trans        &trans        &trans
            >;
        };
    };
};
