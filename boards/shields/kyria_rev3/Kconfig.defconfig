if SHIELD_KYRIA_REV3_DONGLE

# Max 16 characters
config ZMK_KEYBOARD_NAME
    default "Kyria Dongle"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

# 2 peripherals (left + right halves)
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS (2) + desired BT profiles (default 5) = 7
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

endif